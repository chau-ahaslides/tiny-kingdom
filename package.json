{
  "name": "tiny-kingdom",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "lib:build": "node library/build.mjs",
    "lib:upload": "node library/upload.mjs",
    "lib:dev": "wrangler dev -c library/worker/wrangler.jsonc --port 8790",
    "lib:deploy": "wrangler deploy -c library/worker/wrangler.jsonc"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.20.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "esbuild": "^0.25.0",
    "wrangler": "^4.130.0"
  }
}
