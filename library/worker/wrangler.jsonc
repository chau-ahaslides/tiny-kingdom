// The asset-library CDN: a worker in front of the tiny-kingdom-lib R2 bucket, at https://games.ahaslides.io
// (the workers.dev URL keeps working). Deployed on its own, never together with the game worker:
//   npx wrangler r2 bucket create tiny-kingdom-lib            (once)
//   npx wrangler secret put LIB_UPLOAD_TOKEN -c library/worker/wrangler.jsonc   (once; writes)
//   npx wrangler secret put LIB_READ_TOKEN -c library/worker/wrangler.jsonc     (once; agents reading the index)
//   npx wrangler secret put GOOGLE_CLIENT_SECRET -c library/worker/wrangler.jsonc  (once; staff Google sign-in)
//   npx wrangler secret put LIB_SESSION_SECRET -c library/worker/wrangler.jsonc    (once; signs the session cookie)
//   npx wrangler deploy -c library/worker/wrangler.jsonc
{
  "name": "tiny-kingdom-lib",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "games.ahaslides.io", "custom_domain": true }],
  "r2_buckets": [{ "binding": "LIB", "bucket_name": "tiny-kingdom-lib" }],
  // Staff sign in with Google at /auth/login (see the sign-in section of worker.js). GOOGLE_CLIENT_ID is
  // the OAuth client of the "AhaSlides games asset library" app in Google Cloud, whose redirect URI is
  // https://games.ahaslides.io/auth/callback; its secret and the cookie-signing key are wrangler secrets
  // (above). LOGIN_DOMAINS lists the email domains allowed in. Empty client id = no sign-in, key only.
  "vars": { "GOOGLE_CLIENT_ID": "658448366255-8u861uen4ita5b6hou5o2ru0qir898bq.apps.googleusercontent.com", "LOGIN_DOMAINS": "ahaslides.com" }
}
